# Local URL advertised in the Agent Card; keep the trailing slash.
A2A_BASE_URL=http://localhost:8000/a2a/
# Required for AI-backed invoice decisions. Never commit a real key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
DATABASE_PATH=./data/a2a-invoice-agent.sqlite3
# Optional native Gemini provider. If set without GROQ_API_KEY, the app uses it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
